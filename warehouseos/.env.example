# ---------------------------------------------------------------------------
# WarehouseOS environment variables
# Copy this file to ".env" and fill in your own Supabase project values.
# These are PUBLIC browser credentials (safe to expose) — they are protected
# by Supabase Row Level Security, NOT by secrecy.
#
# If you leave both values empty, WarehouseOS automatically runs in DEMO MODE
# using localStorage, so the app is fully usable without any backend.
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon/public key (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=
